{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Cors": {
    "AllowedOrigins": []
  },

  "Messages": {
    "MaximumMessageLength": 4000,
    "Orchestration": {
      "MaximumExecutionTimeSeconds": 120,
      "MaximumToolCalls": 8,
      "MaximumModelTokens": 12000,
      "MaximumEstimatedCost": 1.25,
      "RetrievalCandidateLimit": 20,
      "FinalEvidenceLimit": 8,
      "MaximumContextSize": 30000,
      "MaximumRepeatedToolCalls": 2,
      "MaximumParallelToolCalls": 4
    }
  },

  "ConversationListing": {
    "MaximumPreviewLength": 160
  },

  "Conversations": {
    "MaximumTitleLength": 200
  },

  "Retention": {
    "ConversationRecoveryDays": 30
  },

  "Connectors": {
    "InternalData": {
      "EnabledCategories": [
        "Conversations",
        "Messages"
      ],
      "MaximumResults": 20,
      "MaximumContentLength": 4000
    }
  },

  "AzureAd": {
  "Instance": "https://login.microsoftonline.com/",
  "TenantId": "organizations",
  "ClientId": "f70fb50b-52d5-4346-b769-1121cb3ab3e2",
  "Audience": "f70fb50b-52d5-4346-b769-1121cb3ab3e2",
  "RequiredScope": "access_as_user",
  "RequiredAdmissionRole": "AssistantCore.Access",
  "TenantAdminRole": "TenantAdmin"
  },
  "Microsoft365": {
    "AuthorityBaseUrl": "https://login.microsoftonline.com",
    "GraphBaseUrl": "https://graph.microsoft.com",
    "ClientId": "f70fb50b-52d5-4346-b769-1121cb3ab3e2",
    "ConsentCallbackUrl": "",
    "ConsentSuccessRedirectUrl": "",
    "ConsentErrorRedirectUrl": "",
    "ConsentStateLifetimeMinutes": 10,
    "WebhookBaseUrl": "",
    "SubscriptionLifetimeHours": 48,
    "SubscriptionRenewalLeadTimeHours": 24,
    "SynchronizationLeaseMinutes": 15,
    "SynchronizationIntervalMinutes": 15,
    "AclReconciliationIntervalMinutes": 1440,
    "AclReconciliationRetryMinutes": 15,
    "AclReconciliationBatchSize": 100,
    "MaximumExtractionFileSizeBytes": 26214400,
    "MaximumExtractionExpandedSizeBytes": 104857600,
    "MaximumExtractedCharacters": 2000000,
    "ChunkMaximumTokens": 800,
    "ChunkOverlapTokens": 100,
    "MaximumChunksPerDocument": 1000,
    "EmbeddingEndpoint": "https://api.openai.com/v1",
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingDimensions": 1536,
    "EmbeddingBatchSize": 32,
    "DocumentWorkLeaseMinutes": 10,
    "DocumentWorkRetryMinutes": 5,
    "DocumentWorkMaximumAttempts": 5
  },
  "ServiceBus": {
    "Enabled": false,
    "FullyQualifiedNamespace": "<namespace>.servicebus.windows.net",
    "DriveSyncQueue": "sharepoint-drive-sync",
    "ListSyncQueue": "sharepoint-list-sync"
  },
  "AzureSearch": {
    "Endpoint": "https://<service>.search.windows.net",
    "IndexName": "microsoft-content-dev",
    "EnsureIndexOnStartup": false,
    "SemanticRankingEnabled": true,
    "SemanticConfigurationName": "m365-semantic",
    "MinimumSemanticRelevanceScore": 1.5
  },
  "AiModels": {
    "DefaultModel": "gpt-5.6-luna",
    "Providers": {
      "OpenAI": {
        "Enabled": true,
        "Endpoint": "https://api.openai.com/v1",
        "TimeoutSeconds": 60,
        "Models": {
          "gpt-5.6-luna": {
            "Enabled": true
          },
          "gpt-5.6-terra": {
            "Enabled": true
          },
          "gpt-5.6-sol": {
            "Enabled": true
          }
        }
      },
      "Anthropic": {
        "Enabled": false
      }
    }
  }

}
