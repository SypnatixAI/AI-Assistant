{
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/openai/v1/responses",
    "bodyPatterns": [
      {
        "matchesJsonPath": "$[?(@.stream == true)]"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "text/event-stream; charset=utf-8",
      "Cache-Control": "no-cache"
    },
    "bodyFileName": "openai-streaming-response.txt"
  }
}
