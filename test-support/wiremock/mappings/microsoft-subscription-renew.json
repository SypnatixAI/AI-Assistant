{
  "request": {
    "method": "PATCH",
    "urlPathPattern": "/graph/v1.0/subscriptions/[^/]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\"id\":\"local-subscription\",\"resource\":\"drives/local-drive/root\",\"expirationDateTime\":\"{{jsonPath request.body '$.expirationDateTime'}}\"}",
    "transformers": [
      "response-template"
    ]
  }
}
